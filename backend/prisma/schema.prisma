model VendorContractAsset {
  id         Int            @id @default(autoincrement())
  contractId Int            @map("contract_id")
  contract   VendorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assetId    Int            @map("asset_id")
  asset      Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([contractId, assetId])
  @@map("vendor_contract_assets")
}

model VendorScorecard {
  id                     Int      @id @default(autoincrement())
  vendorId               Int      @map("vendor_id")
  vendor                 Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  period                 String
  onTimeDeliveryPct      Decimal  @map("on_time_delivery_pct") @db.Decimal(5, 2)
  qualityRate            Decimal  @map("quality_rate") @db.Decimal(5, 2)
  priceCompetitiveness   Decimal  @map("price_competitiveness") @db.Decimal(5, 2)
  responsiveness         Decimal  @map("responsiveness") @db.Decimal(5, 2)
  overallScore           Decimal  @map("overall_score") @db.Decimal(5, 2)
  notes                  String?
  recordedById           Int      @map("recorded_by_id")
  recordedBy             User     @relation(fields: [recordedById], references: [id])
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([vendorId])
  @@map("vendor_scorecards")
}

model ProcurementActivityLog {
  id          Int                   @id @default(autoincrement())
  recordType  ProcurementRecordType @map("record_type")
  recordId    Int                   @map("record_id")
  action      String
  summary     String
  before      Json?
  after       Json?
  reason      String?
  actorId     Int                   @map("actor_id")
  actor       User                  @relation(fields: [actorId], references: [id])
  createdAt   DateTime              @default(now()) @map("created_at")

  @@index([recordType, recordId])
  @@map("procurement_activity_logs")
}

model ProcurementAttachment {
  id           Int                   @id @default(autoincrement())
  recordType   ProcurementRecordType @map("record_type")
  recordId     Int                   @map("record_id")
  filename     String
  mimeType     String                @map("mime_type")
  sizeBytes    Int                   @map("size_bytes")
  data         Bytes
  uploadedById Int                   @map("uploaded_by_id")
  uploadedBy   User                  @relation("ProcurementAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([recordType, recordId])
  @@map("procurement_attachments")
}

model ProcurementHandoff {
  id              Int           @id @default(autoincrement())
  kind            HandoffKind
  purchaseOrderId Int           @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptId  Int?          @map("goods_receipt_id")
  goodsReceipt    GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
  contractId      Int?          @map("contract_id")
  contract        VendorContract? @relation(fields: [contractId], references: [id])
  assetId         Int?          @map("asset_id")
  asset           Asset?        @relation(fields: [assetId], references: [id])
  accessoryId     Int?          @map("accessory_id")
  accessory       Accessory?    @relation(fields: [accessoryId], references: [id])
  consumableId    Int?          @map("consumable_id")
  consumable      Consumable?   @relation(fields: [consumableId], references: [id])
  needsReconciliation Boolean   @default(false) @map("needs_reconciliation")
  reconciliationNote  String?   @map("reconciliation_note")
  createdById     Int           @map("created_by_id")
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([purchaseOrderId])
  @@map("procurement_handoffs")
}
