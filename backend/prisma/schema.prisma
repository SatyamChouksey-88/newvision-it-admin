  autoRenew        Boolean            @default(false) @map("auto_renew")
  noticePeriodDays Int                @default(30) @map("notice_period_days")
  slaTerms         String?            @map("sla_terms")
  entitlementCount Int?               @map("entitlement_count")
  usageCount       Int?               @map("usage_count")
  locationId       Int?               @map("location_id")
  location         Location?          @relation(fields: [locationId], references: [id])
  ownerId          Int?               @map("owner_id")
  owner            User?              @relation("ContractOwner", fields: [ownerId], references: [id])
  renewedFromId    Int?               @map("renewed_from_id")
