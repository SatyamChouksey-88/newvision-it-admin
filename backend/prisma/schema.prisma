  recordedBy       User                  @relation("InvoiceRecorder", fields: [recordedById], references: [id])
  filename         String?
  mimeType         String?               @map("mime_type")
  data             Bytes?
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([vendorId])
  @@index([purchaseOrderId])
  @@index([paymentStatus])
  @@map("vendor_invoices")
