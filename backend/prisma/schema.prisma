// NewVision IT Asset Management — Prisma schema
// Postgres. Generated client: prisma-client-js (default).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  IT_ADMIN
  IT_SUPPORT
  MANAGER
  EMPLOYEE
}

enum EmploymentType {
  permanent
  contract
}

enum ChecklistKind {
  onboard
  offboard
}

enum ChatChannelType {
  dm
  group
}

enum AssetStatus {
  available
  assigned
  under_repair
  lost
  damaged
  retired
  disposed
  pending_assignment
}

enum AssetCondition {
  new
  good
  fair
  poor
}

enum MaintenanceStatus {
  reported
  under_repair
  repaired
  reassigned
  cancelled
}

enum AuditAction {
  create
  update
  assign
  transfer
  status_change
  retire
  dispose
  delete
  import
  checkout
  checkin
  stock_adjust
  issue
  approve
  reject
  fulfill
  comment
  manual_override
}

enum NotificationType {
  warranty_expiry
  asset_assigned
  asset_transferred
  issue_reported
  asset_request
  repair_status
  low_stock
  general
  support_ticket
  chat_message
  procurement
  contract_renewal
  vendor_payment
}

enum TicketStatus {
  open
  assigned
  in_progress
  waiting_on_employee
  resolved
  closed
  reopened
}

enum TicketChannel {
  portal
  email
}

enum TicketMessageDirection {
  inbound
  outbound
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum EmailNotifyPref {
  immediate
  daily_digest
}

enum AssetRequestKind {
  asset
  accessory
}

enum AssetRequestStatus {
  pending
  approved
  rejected
  fulfilled
}

enum ImportKind {
  assets
  employees
}

enum ImportJobStatus {
  queued
  previewed
  running
  completed
  failed
  rolled_back
}

enum ReconciliationKind {
  employees
  assets
}

enum VendorStatus {
  draft
  pending_approval
  active
  suspended
  blacklisted
}

enum PurchaseRequisitionStatus {
  draft
  pending_approval
  approved
  rejected
  converted_to_po
  cancelled
}

enum PurchaseOrderStatus {
  draft
  sent
  partially_received
  received
  closed
  cancelled
}

enum InvoiceMatchStatus {
  matched
  exception
}

enum InvoicePaymentStatus {
  pending
  approved
  paid
  overdue
  disputed
  cancelled
}

enum VendorContractType {
  warranty
  amc
  sla
  license_subscription
}

enum RequisitionApprovalKind {
  required
  watcher
}

enum RequisitionApprovalStatus {
  pending
  approved
  rejected
}

enum ApprovalRouting {
  parallel
  sequential
}

enum ProcurementRecordType {
  vendor
  requisition
  purchase_order
  goods_receipt
  invoice
  contract
  scorecard
}

enum HandoffKind {
  serialized
  accessory
  consumable
  license
}

enum LineItemKind {
  serialized
  accessory
  consumable
  license
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

model Role {
  id          Int          @id @default(autoincrement())
  name        RoleName     @unique
  description String?
  users       User[]
  permissions Permission[] @relation("RolePermissions")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  key         String   @unique // e.g. "asset:create", "audit:read"
  description String?
  roles       Role[]   @relation("RolePermissions")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("permissions")
}

model User {
  id                     Int       @id @default(autoincrement())
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  fullName               String    @map("full_name")
  isActive               Boolean   @default(true) @map("is_active")
  roleId                 Int       @map("role_id")
  role                   Role      @relation(fields: [roleId], references: [id])
  employeeId             Int?      @unique @map("employee_id")
  employee               Employee? @relation(fields: [employeeId], references: [id])
  refreshTokenHash       String?   @map("refresh_token_hash")
  refreshTokenExpiresAt  DateTime? @map("refresh_token_expires_at")
  resetPasswordTokenHash String?   @map("reset_password_token_hash")
  resetPasswordExpiresAt DateTime? @map("reset_password_expires_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  auditLogs          AuditLog[]          @relation("AuditActor")
  assignmentsMade    AssetAssignment[]   @relation("AssignmentActor")
  transfersMade      AssetTransfer[]     @relation("TransferActor")
  maintenanceMade    AssetMaintenance[]  @relation("MaintenanceReporter")
  notifications      Notification[]
  importJobs         ImportJob[]
  savedViews         SavedView[]
  reconciliationRuns ReconciliationRun[]
  webhookEndpoints   WebhookEndpoint[]
  reviewedRequests   AssetRequest[]      @relation("RequestReviewer")
  fulfilledRequests  AssetRequest[]      @relation("RequestFulfiller")
  accessoryCheckouts AccessoryCheckout[] @relation("AccessoryCheckoutActor")
  consumableIssues   ConsumableIssue[]   @relation("ConsumableIssueActor")
  emailNotifyPref    EmailNotifyPref     @default(immediate) @map("email_notify_pref")
  assignedTickets    SupportTicket[]     @relation("TicketAssignee")
  ticketComments     TicketComment[]
  ticketTimeLogs     TicketTimeLog[]
  cannedResponses    CannedResponse[]
  ticketTemplates    TicketTemplate[]
  recordNotes        RecordNote[]
  ticketAttachments  TicketAttachment[]  @relation("TicketAttachmentUploader")
  chatMemberships    ChatChannelMember[]
  chatMessages       ChatMessage[]       @relation("ChatAuthor")
  vendorInternalOwned     Vendor[]                    @relation("VendorInternalOwner")
  vendorsApproved         Vendor[]                    @relation("VendorApprover")
  vendorStatusChanges     VendorStatusChange[]
  requisitionsRequested   PurchaseRequisition[]       @relation("RequisitionRequester")
  requisitionApprovals    RequisitionApprover[]
  purchaseOrdersCreated   PurchaseOrder[]             @relation("PoCreator")
  poAmendments            PurchaseOrderAmendment[]
  goodsReceipts           GoodsReceipt[]
  invoicesRecorded        VendorInvoice[]             @relation("InvoiceRecorder")
  contractsOwned          VendorContract[]            @relation("ContractOwner")
  scorecardsRecorded      VendorScorecard[]
  procurementLogs         ProcurementActivityLog[]
  procurementAttachments  ProcurementAttachment[]     @relation("ProcurementAttachmentUploader")
  handoffsCreated         ProcurementHandoff[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Org structure
// ---------------------------------------------------------------------------

model Location {
  id        Int      @id @default(autoincrement())
  code      String   @unique // e.g. PUN, HYD, BHO
  name      String
  city      String
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees      Employee[]
  assets         Asset[]
  transfersFrom  AssetTransfer[] @relation("TransferFromLocation")
  transfersTo    AssetTransfer[] @relation("TransferToLocation")
  supportTickets SupportTicket[]
  accessories    Accessory[]
  consumables    Consumable[]
  requisitions   PurchaseRequisitionLocation[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  contracts      VendorContract[]

  @@map("locations")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employees    Employee[]
  assets       Asset[]
  requisitions PurchaseRequisition[]

  @@map("departments")
}

model Employee {
  id           Int       @id @default(autoincrement())
  employeeCode String    @unique @map("employee_code")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String    @unique
  phone        String?
  designation  String?
  isActive         Boolean        @default(true) @map("is_active")
  employmentType   EmploymentType @default(permanent) @map("employment_type")
  contractEndDate  DateTime?      @map("contract_end_date")
  dateJoined       DateTime?      @map("date_joined")
  checklists       EmployeeChecklist[]

  departmentId Int?        @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  locationId   Int         @map("location_id")
  location     Location    @relation(fields: [locationId], references: [id])
  managerId    Int?        @map("manager_id")
  manager      Employee?   @relation("EmployeeManager", fields: [managerId], references: [id])
  reports      Employee[]  @relation("EmployeeManager")

  user               User?
  assignedAssets     Asset[]             @relation("AssetAssignee")
  assignments        AssetAssignment[]
  transfersFrom      AssetTransfer[]     @relation("TransferFromEmployee")
  transfersTo        AssetTransfer[]     @relation("TransferToEmployee")
  assetRequests      AssetRequest[]
  accessoryCheckouts AccessoryCheckout[]
  consumableIssues   ConsumableIssue[]
  supportTickets     SupportTicket[]     @relation("TicketRequester")
  ticketWatches      TicketWatcher[]
  requisitionsOwned  PurchaseRequisition[] @relation("RequisitionOwner")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([managerId])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Assets
// ---------------------------------------------------------------------------

model AssetCategory {
  id            Int            @id @default(autoincrement())
  code          String         @unique // e.g. LAP, DES, MON
  name          String
  description   String?
  assets        Asset[]
  assetRequests AssetRequest[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("asset_categories")
}

model Asset {
  id                 Int            @id @default(autoincrement())
  assetCode          String         @unique @map("asset_code") // AST-{LOC}-{CAT}-{SEQ}
  categoryId         Int            @map("category_id")
  category           AssetCategory  @relation(fields: [categoryId], references: [id])
  brand              String?
  model              String?
  serialNumber       String?        @unique @map("serial_number")
  purchaseDate       DateTime?      @map("purchase_date")
  purchaseCost       Decimal?       @map("purchase_cost") @db.Decimal(12, 2)
  warrantyStart      DateTime?      @map("warranty_start")
  warrantyEnd        DateTime?      @map("warranty_end")
  locationId         Int            @map("location_id")
  location           Location       @relation(fields: [locationId], references: [id])
  departmentId       Int?           @map("department_id")
  department         Department?    @relation(fields: [departmentId], references: [id])
  assignedEmployeeId Int?           @map("assigned_employee_id")
  assignedEmployee   Employee?      @relation("AssetAssignee", fields: [assignedEmployeeId], references: [id])
  status             AssetStatus    @default(available)
  condition          AssetCondition @default(good)
  vendor             String?
  invoiceNo          String?        @map("invoice_no")
  vendorId           Int?           @map("vendor_record_id")
  vendorRecord       Vendor?        @relation(fields: [vendorId], references: [id])
  purchaseOrderId    Int?           @map("purchase_order_id")
  purchaseOrder      PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptId     Int?           @map("goods_receipt_id")
  goodsReceipt       GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id])
  needsReconciliation Boolean       @default(false) @map("needs_reconciliation")
  reconciliationNote  String?       @map("reconciliation_note")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  assignments    AssetAssignment[]
  transfers      AssetTransfer[]
  maintenance    AssetMaintenance[]
  notifications  Notification[]
  supportTickets SupportTicket[]
  vendorContracts VendorContractAsset[]
  procurementHandoffs ProcurementHandoff[]

  @@index([status])
  @@index([locationId])
  @@index([categoryId])
  @@index([assignedEmployeeId])
  @@map("assets")
}

model AssetAssignment {
  id           Int       @id @default(autoincrement())
  assetId      Int       @map("asset_id")
  asset        Asset     @relation(fields: [assetId], references: [id])
  employeeId   Int       @map("employee_id")
  employee     Employee  @relation(fields: [employeeId], references: [id])
  assignedById Int?      @map("assigned_by_id")
  assignedBy   User?     @relation("AssignmentActor", fields: [assignedById], references: [id])
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  returnedAt   DateTime? @map("returned_at")
  notes        String?

  @@index([assetId])
  @@index([employeeId])
  @@map("asset_assignments")
}

model AssetTransfer {
  id              Int       @id @default(autoincrement())
  assetId         Int       @map("asset_id")
  asset           Asset     @relation(fields: [assetId], references: [id])
  fromEmployeeId  Int?      @map("from_employee_id")
  fromEmployee    Employee? @relation("TransferFromEmployee", fields: [fromEmployeeId], references: [id])
  toEmployeeId    Int?      @map("to_employee_id")
  toEmployee      Employee? @relation("TransferToEmployee", fields: [toEmployeeId], references: [id])
  fromLocationId  Int?      @map("from_location_id")
  fromLocation    Location? @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocationId    Int?      @map("to_location_id")
  toLocation      Location? @relation("TransferToLocation", fields: [toLocationId], references: [id])
  transferredById Int?      @map("transferred_by_id")
  transferredBy   User?     @relation("TransferActor", fields: [transferredById], references: [id])
  transferredAt   DateTime  @default(now()) @map("transferred_at")
  reason          String?

  @@index([assetId])
  @@map("asset_transfers")
}

model AssetMaintenance {
  id                     Int               @id @default(autoincrement())
  assetId                Int               @map("asset_id")
  asset                  Asset             @relation(fields: [assetId], references: [id])
  reportedById           Int?              @map("reported_by_id")
  reportedBy             User?             @relation("MaintenanceReporter", fields: [reportedById], references: [id])
  issue                  String
  status                 MaintenanceStatus @default(reported)
  vendor                 String?
  estimatedCost          Decimal?          @map("estimated_cost") @db.Decimal(12, 2)
  actualCost             Decimal?          @map("actual_cost") @db.Decimal(12, 2)
  reportedAt             DateTime          @default(now()) @map("reported_at")
  expectedCompletionDate DateTime?         @map("expected_completion_date")
  completedAt            DateTime?         @map("completed_at")
  notes                  String?

  @@index([assetId])
  @@index([status])
  @@map("asset_maintenance")
}

// ---------------------------------------------------------------------------
// Audit + notifications
// ---------------------------------------------------------------------------

// Append-only. Application layer exposes INSERT + SELECT only.
model AuditLog {
  id          Int         @id @default(autoincrement())
  entityType  String      @map("entity_type") // e.g. "Asset"
  entityId    String      @map("entity_id")
  action      AuditAction
  summary     String
  oldValue    Json?       @map("old_value")
  newValue    Json?       @map("new_value")
  changedById Int?        @map("changed_by_id")
  changedBy   User?       @relation("AuditActor", fields: [changedById], references: [id])
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id              Int              @id @default(autoincrement())
  userId          Int?             @map("user_id")
  user            User?            @relation(fields: [userId], references: [id])
  type            NotificationType
  title           String
  message         String
  assetId         Int?             @map("asset_id")
  asset           Asset?           @relation(fields: [assetId], references: [id])
  supportTicketId Int?             @map("support_ticket_id")
  supportTicket   SupportTicket?   @relation(fields: [supportTicketId], references: [id])
  isRead          Boolean          @default(false) @map("is_read")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Phase 3 — scale & governance
// ---------------------------------------------------------------------------

model ImportJob {
  id             Int             @id @default(autoincrement())
  kind           ImportKind
  filename       String
  status         ImportJobStatus @default(queued)
  mapping        Json?
  totalRows      Int             @default(0) @map("total_rows")
  createdCount   Int             @default(0) @map("created_count")
  updatedCount   Int             @default(0) @map("updated_count")
  failedCount    Int             @default(0) @map("failed_count")
  duplicateCount Int             @default(0) @map("duplicate_count")
  errors         Json?
  preview        Json?
  createdIds     Json?           @map("created_ids")
  fileData       Bytes?          @map("file_data")
  createdById    Int?            @map("created_by_id")
  createdBy      User?           @relation(fields: [createdById], references: [id])
  createdAt      DateTime        @default(now()) @map("created_at")
  startedAt      DateTime?       @map("started_at")
  finishedAt     DateTime?       @map("finished_at")

  @@index([status])
  @@index([createdById])
  @@map("import_jobs")
}

model SavedView {
  id          Int      @id @default(autoincrement())
  name        String
  resource    String   @default("assets")
  filters     Json
  isShared    Boolean  @default(false) @map("is_shared")
  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([resource, createdById])
  @@map("saved_views")
}

model ReconciliationRun {
  id           Int                @id @default(autoincrement())
  kind         ReconciliationKind
  filename     String
  matchField   String             @map("match_field")
  inFileOnly   Int                @default(0) @map("in_file_only")
  inSystemOnly Int                @default(0) @map("in_system_only")
  matched      Int                @default(0)
  findings     Json
  createdById  Int?               @map("created_by_id")
  createdBy    User?              @relation(fields: [createdById], references: [id])
  createdAt    DateTime           @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("reconciliation_runs")
}

model WebhookEndpoint {
  id            Int       @id @default(autoincrement())
  url           String
  secret        String
  events        String[] // "asset.created" | "asset.status_changed"
  isActive      Boolean   @default(true) @map("is_active")
  lastStatus    Int?      @map("last_status")
  lastError     String?   @map("last_error")
  lastAttemptAt DateTime? @map("last_attempt_at")
  createdById   Int?      @map("created_by_id")
  createdBy     User?     @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("webhook_endpoints")
}

// ---------------------------------------------------------------------------
// Prompt 2 — asset requests, accessories & consumables
// ---------------------------------------------------------------------------

model AssetRequest {
  id              Int                @id @default(autoincrement())
  requesterId     Int                @map("requester_id")
  requester       Employee           @relation(fields: [requesterId], references: [id])
  kind            AssetRequestKind
  categoryId      Int?               @map("category_id")
  category        AssetCategory?     @relation(fields: [categoryId], references: [id])
  accessoryName   String?            @map("accessory_name")
  reason          String
  status          AssetRequestStatus @default(pending)
  managerComment  String?            @map("manager_comment")
  rejectionReason String?            @map("rejection_reason")
  reviewedById    Int?               @map("reviewed_by_id")
  reviewedBy      User?              @relation("RequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?          @map("reviewed_at")
  fulfilledById   Int?               @map("fulfilled_by_id")
  fulfilledBy     User?              @relation("RequestFulfiller", fields: [fulfilledById], references: [id])
  fulfilledAt     DateTime?          @map("fulfilled_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@index([requesterId])
  @@map("asset_requests")
}

model Accessory {
  id                 Int                 @id @default(autoincrement())
  name               String
  category           String
  quantityTotal      Int                 @map("quantity_total")
  quantityCheckedOut Int                 @default(0) @map("quantity_checked_out")
  locationId         Int?                @map("location_id")
  location           Location?           @relation(fields: [locationId], references: [id])
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  checkouts          AccessoryCheckout[]
  procurementHandoffs ProcurementHandoff[]

  @@index([category])
  @@index([locationId])
  @@map("accessories")
}

model AccessoryCheckout {
  id            Int       @id @default(autoincrement())
  accessoryId   Int       @map("accessory_id")
  accessory     Accessory @relation(fields: [accessoryId], references: [id])
  employeeId    Int       @map("employee_id")
  employee      Employee  @relation(fields: [employeeId], references: [id])
  quantity      Int       @default(1)
  checkedOutAt  DateTime  @default(now()) @map("checked_out_at")
  checkedInAt   DateTime? @map("checked_in_at")
  processedById Int?      @map("processed_by_id")
  processedBy   User?     @relation("AccessoryCheckoutActor", fields: [processedById], references: [id])
  notes         String?

  @@index([accessoryId])
  @@index([employeeId])
  @@map("accessory_checkouts")
}

model Consumable {
  id                Int               @id @default(autoincrement())
  name              String
  category          String
  quantityTotal     Int               @map("quantity_total")
  quantityAvailable Int               @map("quantity_available")
  lowStockThreshold Int               @default(5) @map("low_stock_threshold")
  locationId        Int?              @map("location_id")
  location          Location?         @relation(fields: [locationId], references: [id])
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  issues            ConsumableIssue[]
  procurementHandoffs ProcurementHandoff[]

  @@index([category])
  @@index([locationId])
  @@map("consumables")
}

model ConsumableIssue {
  id            Int        @id @default(autoincrement())
  consumableId  Int        @map("consumable_id")
  consumable    Consumable @relation(fields: [consumableId], references: [id])
  employeeId    Int        @map("employee_id")
  employee      Employee   @relation(fields: [employeeId], references: [id])
  quantity      Int        @default(1)
  issuedAt      DateTime   @default(now()) @map("issued_at")
  processedById Int?       @map("processed_by_id")
  processedBy   User?      @relation("ConsumableIssueActor", fields: [processedById], references: [id])

  @@index([consumableId])
  @@index([employeeId])
  @@map("consumable_issues")
}

// ---------------------------------------------------------------------------
// Support tickets (Prompt 14/15) + universal notes (Prompt 16)
// ---------------------------------------------------------------------------

model TicketCategory {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  name            String
  defaultPriority TicketPriority   @default(medium) @map("default_priority")
  tickets         SupportTicket[]
  templates       TicketTemplate[]
  createdAt       DateTime         @default(now()) @map("created_at")

  @@map("ticket_categories")
}

model SupportTicket {
  id                    Int             @id @default(autoincrement())
  ticketNumber          String          @unique @map("ticket_number")
  subject               String
  description           String
  categoryId            Int             @map("category_id")
  category              TicketCategory  @relation(fields: [categoryId], references: [id])
  priority              TicketPriority  @default(medium)
  status                TicketStatus    @default(open)
  raisedById            Int             @map("raised_by_id")
  raisedBy              Employee        @relation("TicketRequester", fields: [raisedById], references: [id])
  assignedToId          Int?            @map("assigned_to_id")
  assignedTo            User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  assetId               Int?            @map("asset_id")
  asset                 Asset?          @relation(fields: [assetId], references: [id])
  locationId            Int?            @map("location_id")
  location              Location?       @relation(fields: [locationId], references: [id])
  dueDate               DateTime?       @map("due_date")
  resolvedAt            DateTime?       @map("resolved_at")
  closedAt              DateTime?       @map("closed_at")
  totalTimeSpentMinutes Int             @default(0) @map("total_time_spent_minutes")
  satisfactionRating    Int?            @map("satisfaction_rating")
  satisfactionComment   String?         @map("satisfaction_comment")
  ratedAt               DateTime?       @map("rated_at")
  ratingPromptDropped   Boolean         @default(false) @map("rating_prompt_dropped")
  duplicateOfId         Int?            @map("duplicate_of_id")
  duplicateOf           SupportTicket?  @relation("TicketDuplicate", fields: [duplicateOfId], references: [id])
  duplicates            SupportTicket[] @relation("TicketDuplicate")
  channel               TicketChannel   @default(portal)
  unmatchedSender       String?         @map("unmatched_sender")
  firstResponseAt       DateTime?       @map("first_response_at")
  waitingSince          DateTime?       @map("waiting_since")
  waitingTotalMinutes   Int             @default(0) @map("waiting_total_minutes")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  comments      TicketComment[]
  watchers      TicketWatcher[]
  timeLogs      TicketTimeLog[]
  attachments   TicketAttachment[]
  notifications Notification[]
  messages      TicketMessage[]

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([raisedById])
  @@index([dueDate])
  @@map("support_tickets")
}

/**
 * Outbound/inbound email metadata for the ticket mail thread — powers email-in matching.
 */
model TicketMessage {
  id          Int                    @id @default(autoincrement())
  ticketId    Int                    @map("ticket_id")
  ticket      SupportTicket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  direction   TicketMessageDirection
  messageId   String                 @unique @map("message_id")
  inReplyTo   String?                @map("in_reply_to")
  references  String?
  fromAddress String                 @map("from_address")
  toAddress   String?                @map("to_address")
  subject     String?
  createdAt   DateTime               @default(now()) @map("created_at")

  @@index([ticketId])
  @@index([inReplyTo])
  @@map("ticket_messages")
}

/**
 * Simple per-priority first-response target (minutes) — Settings, not a rules engine.
 */
model TicketPriorityTarget {
  id            Int            @id @default(autoincrement())
  priority      TicketPriority @unique
  targetMinutes Int?           @map("target_minutes")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("ticket_priority_targets")
}

/**
 * Singleton (id=1) status row for the email-in poller, surfaced in Settings.
 */
model EmailIngestState {
  id               Int       @id @default(1)
  lastCheckedAt    DateTime? @map("last_checked_at")
  lastMessageCount Int       @default(0) @map("last_message_count")
  lastError        String?   @map("last_error")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("email_ingest_state")
}

model TicketComment {
  id              Int                @id @default(autoincrement())
  ticketId        Int                @map("ticket_id")
  ticket          SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId        Int?               @map("author_id")
  author          User?              @relation(fields: [authorId], references: [id])
  /**
   * Set instead of authorId when an email-in reply's sender doesn't match a known user/employee.
   */
  unmatchedSender String?            @map("unmatched_sender")
  body            String
  isInternal      Boolean            @default(false) @map("is_internal")
  createdAt       DateTime           @default(now()) @map("created_at")
  attachments     TicketAttachment[]

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketWatcher {
  id         Int           @id @default(autoincrement())
  ticketId   Int           @map("ticket_id")
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  employeeId Int           @map("employee_id")
  employee   Employee      @relation(fields: [employeeId], references: [id])
  createdAt  DateTime      @default(now()) @map("created_at")

  @@unique([ticketId, employeeId])
  @@map("ticket_watchers")
}

model TicketTimeLog {
  id       Int           @id @default(autoincrement())
  ticketId Int           @map("ticket_id")
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staffId  Int           @map("staff_id")
  staff    User          @relation(fields: [staffId], references: [id])
  minutes  Int
  note     String?
  loggedAt DateTime      @default(now()) @map("logged_at")

  @@index([ticketId])
  @@map("ticket_time_logs")
}

model TicketAttachment {
  id           Int            @id @default(autoincrement())
  ticketId     Int            @map("ticket_id")
  ticket       SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId    Int?           @map("comment_id")
  comment      TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  filename     String
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  data         Bytes
  uploadedById Int            @map("uploaded_by_id")
  uploadedBy   User           @relation("TicketAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("ticket_attachments")
}

model CannedResponse {
  id           Int            @id @default(autoincrement())
  title        String
  body         String
  /** Optional status applied when this snippet is sent as a public reply. */
  statusOnSend TicketStatus?  @map("status_on_send")
  createdById  Int            @map("created_by_id")
  createdBy    User           @relation(fields: [createdById], references: [id])
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("canned_responses")
}

model TicketTemplate {
  id          Int            @id @default(autoincrement())
  title       String
  subject     String
  description String
  categoryId  Int            @map("category_id")
  category    TicketCategory @relation(fields: [categoryId], references: [id])
  createdById Int            @map("created_by_id")
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("ticket_templates")
}

model ChecklistTemplate {
  id        Int                     @id @default(autoincrement())
  name      String
  kind      ChecklistKind
  items     ChecklistTemplateItem[]
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id         Int                @id @default(autoincrement())
  templateId Int                @map("template_id")
  template   ChecklistTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  sortOrder  Int                @default(0) @map("sort_order")

  @@map("checklist_template_items")
}

model EmployeeChecklist {
  id         Int                      @id @default(autoincrement())
  employeeId Int                      @map("employee_id")
  employee   Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId Int?                     @map("template_id")
  kind       ChecklistKind
  status     String                   @default("in_progress")
  items      EmployeeChecklistItem[]
  createdAt  DateTime                 @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("employee_checklists")
}

model ChatChannel {
  id        Int                 @id @default(autoincrement())
  type      ChatChannelType
  name      String?
  createdAt DateTime            @default(now()) @map("created_at")
  members   ChatChannelMember[]
  messages  ChatMessage[]

  @@map("chat_channels")
}

model ChatChannelMember {
