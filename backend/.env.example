# Copy to .env for local dev. docker-compose provides these for the container.
DATABASE_URL="postgresql://newvision:newvision@localhost:5432/newvision?schema=public"
JWT_SECRET="change-me-in-production-super-secret"
JWT_REFRESH_SECRET="change-me-refresh-in-production"
JWT_EXPIRES_IN="15m"
# Opt-in only (Phase 1 hardening) — unset or any value other than "true" disables the seeded
# @newvision.local demo accounts, in every environment including local dev.
ALLOW_DEMO_LOGINS="true"
SWAGGER_ENABLED="true"
SEED_IF_EMPTY="true"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Pusher Channels (staff chat real-time). Create a free app at pusher.com for local dev.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""

# Hostinger hPanel cron — POST /api/internal/cron/* with header X-Cron-Secret
CRON_SECRET=""

# Transactional email. Prefer Resend (HTTPS) in production — Render Free blocks SMTP 587/465.
# Leave both RESEND_API_KEY and SMTP_HOST blank to log mail to the console.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="NewVision IT <it-noreply@newvision.local>"

# Production-only: when the database is empty, seed roles + one Super Admin (no demo estate).
# SEED_MODE=bootstrap
# BOOTSTRAP_ADMIN_EMAIL="you@company.com"
# BOOTSTRAP_ADMIN_PASSWORD="at-least-12-chars"
# BOOTSTRAP_ADMIN_NAME="Your Name"

# Shared helpdesk mailbox for email-in (one mailbox). Outbound ticket mail uses this as Reply-To.
HELPDESK_MAILBOX="it@newvision.local"

# Optional IMAP poller (every minute). Leave IMAP_HOST blank in local dev — the poller no-ops.
# Alternatively POST raw RFC-822 to /api/email-in/ingest (IT Admin JWT) or /api/email-in/webhook
# with header X-Email-Ingest-Secret.
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASS=""
IMAP_MAILBOX="INBOX"
EMAIL_INGEST_SECRET=""

# Origin encoded into asset QR codes (the public /scan/:code page) and into every email's
# logo image / call-to-action links (e.g. https://it.newvision-software.com in production).
PUBLIC_APP_URL="http://localhost:5173"

# Super Admin MFA (TOTP) is enforced by default everywhere (Phase 1 hardening). Uncomment to
# opt out locally, e.g. while testing something unrelated without wanting to enroll TOTP:
# REQUIRE_SUPERADMIN_MFA=false

# Microsoft Entra ID — "Sign in with Microsoft" (Phase 2). Leave all four blank for local dev:
# the app falls back to its own built-in mock OIDC provider (backend/src/auth/mock-idp/) so the
# whole sign-in flow is testable without a real Entra app registration. Fill these in with a
# real (ideally a test/non-production) Entra App Registration's values to go live:
#   - MS_TENANT_ID: the Directory (tenant) ID from the App Registration's Overview page.
#   - MS_CLIENT_ID: the Application (client) ID from the same page.
#   - MS_CLIENT_SECRET: a client secret created under Certificates & secrets. Treat like any
#     other production secret — never commit a real value.
#   - MS_REDIRECT_URI: must exactly match a Redirect URI configured on the App Registration
#     (Web platform). Locally this is http://localhost:3000/api/auth/entra/callback; in
#     production it must be the real backend's own public URL + /auth/entra/callback.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_REDIRECT_URI=

# This backend's own public URL (distinct from PUBLIC_APP_URL, the frontend's). Used to build
# the Entra callback URL and, in dev, to serve the mock IdP under its own origin.
# PUBLIC_API_URL="http://localhost:3000/api"

# Set to "false" to disable the mock IdP even in local dev (e.g. while testing that Entra is
# genuinely unconfigured). Hard-disabled in production regardless of this value.
# MOCK_ENTRA_IDP_ENABLED=true

# Phase 3 — JIT provisioning into the single internal workspace (slug must exist in tenants table).
# ENTRA_JIT_TENANT_SLUG=newvision
# Phase 13 — comma-separated emails that JIT/link to Super Admin on first Microsoft sign-in (Render only).
# INITIAL_SUPER_ADMIN_EMAILS=you@company.com,other@company.com
# Self-serve POST /auth/signup removed — new tenants via platform ops / provisionTenant in tests.
# Optional: only users in this Entra security group may JIT-provision (see docs/TECHNICAL_REFERENCE.md#entra-jit-eligibility-microsoft-side-setup).
# MS_APPROVED_SECURITY_GROUP_ID=

# Phase 4 — only after Entra Conditional Access enforces MFA (see docs/TECHNICAL_REFERENCE.md#mfa-transition-local-totp-entra-conditional-access).
# ENTRA_SATISFIES_MFA=false

# SaaS / multi-tenant (legacy — NewVision is now a single-tenant internal deployment; these
# stay wired for the existing tenancy isolation layer but are not being extended further)
# HOSTING_REGION=singapore  # advertised on GET /api/health. Singapore = demo; India on request.
# PLATFORM_ADMIN_SECRET=    # ops hook to mark a tenant Team/active after Zoho Books payment
# JWT_REFRESH_SECRET=

# Observability (optional — no DSN = Sentry disabled)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Log Postgres queries slower than N ms (default off — set e.g. 500 in staging)
# PRISMA_SLOW_QUERY_MS=500
