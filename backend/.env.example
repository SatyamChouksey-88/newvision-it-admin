# Copy to .env for local dev. docker-compose provides these for the container.
DATABASE_URL="postgresql://newvision:newvision@localhost:5432/newvision?schema=public"
JWT_SECRET="change-me-in-production-super-secret"
JWT_EXPIRES_IN="8h"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# SMTP for warranty alert emails (Phase 2). Leave blank to log emails to console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="NewVision IT <it-noreply@newvision.local>"

# Origin encoded into asset QR codes (the public /scan/:code page).
PUBLIC_APP_URL="http://localhost:5173"
