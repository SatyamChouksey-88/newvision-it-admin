{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": { "includes": ["src/**/*.ts", "src/**/*.tsx"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "off", "noArrayIndexKey": "off" },
      "style": { "noNonNullAssertion": "off", "useImportType": "off" },
      "a11y": { "useKeyWithClickEvents": "off" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all" } }
}
